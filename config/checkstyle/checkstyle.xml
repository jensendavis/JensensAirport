<?xml version="1.0"?>
<!DOCTYPE module PUBLIC "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN" "http://checkstyle.sourceforge.net/dtds/configuration_1_3.dtd">

<configuration>

    <!-- Global Configuration -->
    <module name="Checker">
        <module name="TreeWalker">
            <!-- Naming Conventions -->
            <module name="PackageDeclaration"/>
            <module name="ImportOrder">
                <property name="ordered" value="true"/>
                <property name="separateLine" value="true"/>
            </module>
            <module name="EmptyBlock"/>
            <module name="JavadocMethod">
                <property name="allowEmpty" value="false"/>
            </module>
            <module name="JavadocType"/>
            <module name="FinalClass"/>
            <module name="FinalMethod"/>

            <!-- Class Design -->
            <module name="VisibilityModifier">
                <property name="checkPublic" value="false"/>
                <property name="checkPackage" value="true"/>
            </module>

            <!-- Formatting -->
            <module name="Indentation">
                <property name="basicOffset" value="4"/>
                <property name="indentation" value="4"/>
            </module>
            <module name="LineLength">
                <property name="max" value="100"/>
            </module>
            <module name="MethodLength">
                <property name="max" value="50"/>
            </module>

            <!-- Coding Style -->
            <module name="IllegalTokenText">
                <property name="tokens" value="LITERAL_for, LITERAL_while"/>
            </module>

            <!-- Commenting -->
            <module name="CommentFormat">
                <property name="lineFormat" value=".*[\\*\\/]+.*"/>
            </module>
            <module name="MissingJavadocMethod">
                <property name="allowedExceptions" value="noJavadocMethods"/>
            </module>
            <module name="MissingJavadocType"/>

            <!-- Code Complexity -->
            <module name="CyclomaticComplexity">
                <property name="max" value="10"/>
            </module>
            <module name="Metric"/>
        </module>
    </module>

</configuration>